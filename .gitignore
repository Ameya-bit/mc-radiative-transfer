# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Editable install / venv
*.egg-link
.venv/
venv/

# Simulation outputs: keep result plots AND the paper-backing npz evidence base
# (Zenodo archives this repo via GitHub, so the npz artifacts must be tracked).
# data/l26_reference/ and data/apjlab5968.tar.gz are AAS supplementary material
# (Bogdanov et al. 2019) whose redistribution is not granted — they stay ignored;
# see REPRODUCING.md for how to re-download them.
data/*
!data/.gitkeep
!data/*.png
!data/*.npz

# Manuscript and submission material stay private (text, bibliography, referee
# correspondence, poster, submission bundles). Only the paper-prep documentation
# (*.md) and the figure-generation code in docs/paper/ are tracked.
docs/paper/*
!docs/paper/*.md
!docs/paper/poster/
docs/paper/poster/*
!docs/paper/poster/updated_graphs/
docs/paper/poster/updated_graphs/*
!docs/paper/poster/updated_graphs/make_updated_figs.py
!docs/paper/poster/updated_graphs/README.md

# LaTeX build artifacts
*.aux
*.fls
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.toc
*.bbl
*.blg

# macOS
.DS_Store

# personal notes
notes/*
research_contract/*

